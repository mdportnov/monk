<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lists every launchable app in "Add apps". Sideloaded build; Play would ask for a justification. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Optional: lets the pause screen start from the background on OEMs that ignore the
         accessibility-service exemption. Requested from the setup card, never at launch. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".MonkApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Monk">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Own task, hidden from Recents, gone the moment it is left. -->
        <activity
            android:name=".InterceptActivity"
            android:exported="false"
            android:launchMode="singleInstance"
            android:taskAffinity="com.mdportnov.monk.intercept"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:showOnLockScreen="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.Monk.Intercept" />

        <service
            android:name=".MonkAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/monk_accessibility_service" />
        </service>
    </application>

</manifest>
