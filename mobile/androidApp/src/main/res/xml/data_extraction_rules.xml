<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: allowBackup=false only covers cloud backups; device-to-device transfer is opted out here. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="database" />
    </device-transfer>
</data-extraction-rules>
