(( $+functions[_monk_commands] )) ||
_monk_commands() {
    local commands; commands=(
'init:Run the interactive onboarding wizard' \
'tui:Open the interactive TUI' \
'lang:Set the interface language' \
'start:Start a focus session of a routine (the default one if omitted)' \
'stop:Stop the active session early (not a no-exit one)' \
'extend:Add time to the active session' \
'panic:Ask for a delayed emergency exit from a no-exit session' \
'status:Show background service and session status' \
'routines:List routines' \
'routine:Manage routines (what to block, when, how firmly)' \
'apps:Manage installed applications cache' \
'stats:Show session statistics' \
'doctor:Check the setup and the background service; --fix repairs what it can' \
'config:Manage configuration' \
'service:Manage the background service' \
'menubar:Run the menu bar companion app (macOS only)' \
'completions:Generate shell completions' \
'update:Check GitHub releases for a new version and self-update' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'monk commands' commands "$@"
}
